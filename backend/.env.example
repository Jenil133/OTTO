# OTTO backend env vars — copy to .env locally / set on Render (never commit .env).
# A missing key silently degrades that adapter to mock (architecture D6).
#
# ┌─ ONE-KEY QUICKSTART (TokenRouter $50 credit) ───────────────────────────┐
# │ TokenRouter is an OpenAI-compatible gateway — ONE key reaches Kimi K3    │
# │ (planner) AND MiniMax M3 (synthesizer). Minimum to take the brain live:  │
# │   TOKENROUTER_API_KEY=<your key>                                         │
# │   KIMI_MODEL=<Kimi K3 id from the TokenRouter models page>               │
# │   MINIMAX_MODEL=<MiniMax id from the TokenRouter models page>            │
# │ Leave OTTO_MOCK empty. Retriever still mocks until its key is added, so  │
# │ the spine runs live LLMs today and swaps in real web agents Saturday.   │
# └─────────────────────────────────────────────────────────────────────────┘

# Global kill-switch: 1 forces EVERY adapter to mock regardless of keys present.
OTTO_MOCK=

# Retriever — cloud browser sessions (Zone-1 web agents, D1 step [2]).
RETRIEVER_API_KEY=

# TokenRouter — ONE gateway key for BOTH the Kimi K3 planner (D1 step [1]) and,
# unless MINIMAX_API_KEY is set below, the MiniMax M3 synthesizer (D1 step [3]).
TOKENROUTER_API_KEY=

# TokenRouter — base URL. Default https://api.tokenrouter.com/v1 ; override only
# if the console shows a different one.
TOKENROUTER_BASE_URL=

# Planner model — ANY id from TokenRouter's catalog (117 models on one key).
# Benchmarked live on the real planner prompt (adapters/kimi.py has the table):
#   google/gemini-3.5-flash-lite  2.8s  3 subtasks  <- default
#   moonshotai/kimi-k3           28.0s  3 subtasks  (reasoning model, 10x slower)
# `KIMI_MODEL` still works as a legacy alias.
PLANNER_MODEL=

# Exact MiniMax model string from TokenRouter's models page (MiniMax row).
MINIMAX_MODEL=

# MiniMax — set ONLY to call MiniMax natively instead of via TokenRouter. Left
# blank, the synthesizer routes M3 through the TokenRouter key above.
MINIMAX_API_KEY=
# MINIMAX_BASE_URL=   # native MiniMax full chat-completion URL (only if using MINIMAX_API_KEY)

# mem0 — preference memory read/write (side service, off critical path).
MEM0_API_KEY=

# Band — otto-ops room posting (lifecycle audit log).
BAND_API_KEY=

# Band — room name every actor posts into (CONTRACTS.md §5).
BAND_ROOM=otto-ops

# Respan — LLM gateway key (cost + latency telemetry).
RESPAN_API_KEY=

# Respan — gateway base URL LLM calls exit through.
RESPAN_BASE_URL=

# ElevenLabs — conversational agent STT/TTS (voice edge, D3).
ELEVENLABS_API_KEY=

# ElevenLabs — the configured agent id with the run_task() tool attached.
ELEVENLABS_AGENT_ID=
